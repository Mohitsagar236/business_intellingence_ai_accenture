# Copy this file to .env and fill in real values. .env is gitignored.

# "development" (default) allows the insecure JWT_SECRET default below, so a fresh checkout
# runs with zero config. Set APP_ENV=production before deploying anywhere real — this turns on
# a hard startup check (app/config.py) that refuses to start if JWT_SECRET is still this
# published default or shorter than 32 characters, rather than silently signing tokens with it.
APP_ENV=development

# SQLite by default — zero setup. Point this at a Postgres URL to swap databases
# (e.g. postgresql+psycopg2://user:pass@host:5432/dbname) with no code changes.
DATABASE_URL=sqlite:///./data/app.db

# Enables LLM-grounded narrative generation (Stage 4b). Without any key set below, narrative
# generation falls back to a deterministic template writer over the same evidence — the
# pipeline still runs end-to-end, just with plainer report prose. Report.generated_by tells you
# which path actually ran ("claude" vs "template").
#
# Three ways to reach an LLM — set ONE of these, not more than one. Priority if several are
# set: Gemini, then OpenRouter, then Anthropic.
#   1. Google Gemini:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
#   2. Direct Anthropic API key:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
#   3. OpenRouter (an OpenAI-compatible gateway):
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5

CORS_ORIGINS=http://localhost:5173

# Signs login JWTs — change this to a real random value anywhere beyond your own machine.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (rejected if left at this default, or under 32 chars) once APP_ENV=production.
JWT_SECRET=dev-insecure-secret-change-me
